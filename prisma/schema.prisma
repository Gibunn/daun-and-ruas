generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  fullname     String
  email        String  @unique
  phone_number String
  password     String
  is_admin     Boolean @default(false)

  addressTables AddressTable[]
}

model AddressTable {
  id               String  @id @default(cuid())
  address_label    String
  receiver_name    String
  phone_number     String
  complete_address String
  province         String
  city             String
  district         String
  postal_code      String
  main_address     Boolean @default(false)

  user    User   @relation(fields: [user_id], references: [id])
  user_id String
}
